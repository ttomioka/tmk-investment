<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">

  <profiles>
    <profile>
      <id>local-jooq</id>
      <properties>
        <jooq.codegen.skip>false</jooq.codegen.skip>
        <jooq.codegen.jdbc.url>jdbc:mysql://localhost:3306/tmk_trader</jooq.codegen.jdbc.url>
        <jooq.codegen.jdbc.user>devuser</jooq.codegen.jdbc.user>
        <jooq.codegen.jdbc.password>devuser</jooq.codegen.jdbc.password>
        <jooq.codegen.jdbc.initScript>${project.basedir}/src/main/resources/schema.sql</jooq.codegen.jdbc.initScript>
      </properties>
    </profile>
  </profiles>

  <activeProfiles>
	  <activeProfile>local-jooq</activeProfile>
	</activeProfiles>

</settings>